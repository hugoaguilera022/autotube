{
  "name": "autotube",
  "version": "0.1.0",
  "private": true,
  "description": "AutoTube - AI-assisted YouTube content automation dashboard",
  "main": "server.js",
  "scripts": {
    "start": "AUTOTUBE_DISABLE_LTX=0 node --expose-gc -r ./disable-startup-selftest-preload.js -r ./youtube-routes-preload.js -r ./render-stability-preload.js -r ./url-to-mp4-preload.js -r ./gemini-image-fix-preload.js -r ./disable-ltx-preload.js -r ./render-memory-preload.js -r ./wan27-zerogpu-bridge-preload.js server.js",
    "dev": "AUTOTUBE_DISABLE_LTX=0 node --expose-gc -r ./disable-startup-selftest-preload.js -r ./youtube-routes-preload.js -r ./render-stability-preload.js -r ./url-to-mp4-preload.js -r ./gemini-image-fix-preload.js -r ./disable-ltx-preload.js -r ./render-memory-preload.js -r ./wan27-zerogpu-bridge-preload.js server.js --watch"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "@supabase/supabase-js": "^2.57.4",
    "ffmpeg-static": "^5.2.0",
    "multer": "^2.0.2",
    "@gradio/client": "^1.17.0",
    "jsonrepair": "^3.13.0",
    "@hiudyy/ytdl": "0.2.3",
    "@huggingface/inference": "^4.13.30",
    "@fal-ai/client": "^1.6.2"
  }
}
