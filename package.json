{
  "name": "autotube",
  "version": "0.1.0",
  "private": true,
  "description": "AutoTube - AI-assisted YouTube content automation dashboard",
  "main": "server.js",
  "scripts": {
    "start": "AUTOTUBE_DISABLE_LTX=1 node --expose-gc -r ./disable-startup-selftest-preload.js -r ./youtube-download-fallback-preload.js -r ./youtube-routes-preload.js -r ./render-stability-preload.js -r ./url-to-mp4-preload.js -r ./gemini-image-fix-preload.js -r ./disable-ltx-preload.js server.js",
    "dev": "AUTOTUBE_DISABLE_LTX=1 node --expose-gc -r ./disable-startup-selftest-preload.js -r ./youtube-download-fallback-preload.js -r ./youtube-routes-preload.js -r ./render-stability-preload.js -r ./url-to-mp4-preload.js -r ./gemini-image-fix-preload.js -r ./disable-ltx-preload.js server.js --watch",
    "postinstall": "node setup-pot-provider.js"
  },
  "engines": { "node": "22.x" },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "@supabase/supabase-js": "^2.57.4",
    "ffmpeg-static": "^5.2.0",
    "multer": "^2.0.2",
    "youtube-dl-exec": "^3.1.15",
    "@gradio/client": "^1.17.0",
    "jsonrepair": "^3.13.0"
  }
}
